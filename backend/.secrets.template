# Secrets Configuration for Строительная система управления
# This file contains sensitive information and should NEVER be committed to version control
# Copy this file to .secrets and fill in your actual values

# =============================================================================
# CRITICAL SECURITY SETTINGS
# =============================================================================

# JWT Secret - Generate a strong secret (32+ characters minimum)
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_TO_STRONG_SECRET_32_CHARS_MIN

# Database Password - Use strong password (minimum 16 characters)
DATABASE_PASSWORD=CHANGE_ME_TO_STRONG_DB_PASSWORD_MIN_16_CHARS

# Redis Password - Use strong password
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_REDIS_PASSWORD

# =============================================================================
# AI SERVICE API KEYS
# =============================================================================

# OpenAI API Key for AI services
OPENAI_API_KEY=sk-proj-...

# Google Gemini API Key
GEMINI_API_KEY=...

# Anthropic Claude API Key
ANTHROPIC_API_KEY=...

# Groq API Key (optional)
GROQ_API_KEY=...

# =============================================================================
# EMAIL SERVICE CREDENTIALS
# =============================================================================

# SMTP Password for notifications
SMTP_PASSWORD=your-app-password

# =============================================================================
# ENCRYPTION KEYS
# =============================================================================

# Data encryption key for sensitive information
ENCRYPTION_KEY=CHANGE_ME_TO_32_CHAR_ENCRYPTION_KEY

# Session encryption key
SESSION_ENCRYPTION_KEY=CHANGE_ME_TO_32_CHAR_SESSION_KEY

# =============================================================================
# SSL/TLS CERTIFICATES
# =============================================================================

# SSL certificate paths (if using custom certificates)
SSL_CERT_PATH=/etc/ssl/certs/stroy-control.crt
SSL_KEY_PATH=/etc/ssl/private/stroy-control.key

# =============================================================================
# MONITORING & ANALYTICS
# =============================================================================

# External monitoring service keys (if using)
SENTRY_DSN=https://...
DATADOG_API_KEY=...
NEW_RELIC_LICENSE_KEY=...

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Third-party service API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SMS service for notifications
SMS_API_KEY=...
SMS_API_SECRET=...

# Push notification service
VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...

# =============================================================================
# BACKUP & STORAGE
# =============================================================================

# AWS S3 credentials for backups
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_S3_BUCKET=stroy-backups

# =============================================================================
# SECURITY & AUDIT
# =============================================================================

# API key for external security scanning
SECURITY_API_KEY=...

# Webhook secret for GitHub/GitLab integrations
GITHUB_WEBHOOK_SECRET=...
GITLAB_WEBHOOK_SECRET=...

# =============================================================================
# PRODUCTION DOMAINS
# =============================================================================

# Update these to your actual production domains
PRODUCTION_DOMAIN=yourdomain.com
API_DOMAIN=api.yourdomain.com
FRONTEND_DOMAIN=app.yourdomain.com

# =============================================================================
# INSTRUCTIONS FOR PRODUCTION SETUP
# =============================================================================

# 1. Generate strong secrets:
#    - JWT Secret: openssl rand -base64 32
#    - Database Password: openssl rand -base64 16
#    - Redis Password: openssl rand -base64 16
#    - Encryption Key: openssl rand -base64 32

# 2. Obtain API keys:
#    - OpenAI: https://platform.openai.com/api-keys
#    - Gemini: https://makersuite.google.com/app/apikey
#    - Anthropic: https://console.anthropic.com/

# 3. Set up SMTP credentials for email notifications

# 4. Configure SSL certificates for your domains

# 5. Set up monitoring services (Sentry, DataDog, etc.)

# 6. Configure backup storage (AWS S3, etc.)

# 7. NEVER commit this file to version control
# 8. Use environment-specific secrets management in production