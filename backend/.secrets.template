# Secrets Template for Строительная система управления
# Copy this file to .secrets and fill in your actual values

# Database
POSTGRES_PASSWORD=your_secure_postgres_password_here
REDIS_PASSWORD=your_secure_redis_password_here

# JWT Security
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_here

# AI API Keys
OPENAI_API_KEY=sk-your_openai_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Email Configuration
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Application URLs
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://api.yourdomain.com
AI_GATEWAY_URL=https://ai.yourdomain.com

# SSL Certificates (file paths)
SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem

# External Services
S3_BUCKET_NAME=stroy-documents
S3_REGION=us-east-1
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key

# Security
BCRYPT_COST=12
RATE_LIMIT_SECRET=your_rate_limiting_secret

# Monitoring
GRAFANA_ADMIN_PASSWORD=secure_grafana_password_here
PROMETHEUS_RETENTION=200h

# Backup
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
BACKUP_S3_BUCKET=stroy-backups

# Optional: CloudFlare (for production)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_zone_id