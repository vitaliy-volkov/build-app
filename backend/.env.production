# Production Environment Configuration for Строительная система управления

# Server Configuration
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s

# Database Configuration (PostgreSQL)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=stroy_user
DATABASE_PASSWORD=secure_production_password_change_me
DATABASE_DBNAME=stroy_control
DATABASE_SSL_MODE=require

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=secure_redis_password_change_me
REDIS_DB=0

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_minimum_32_characters_for_production_security
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h
JWT_ISSUER=stroy-control-backend

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=info

# CORS Settings
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# File Upload Settings
MAX_FILE_SIZE=50MB
UPLOAD_PATH=/app/uploads
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,doc,docx

# External Services
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=stroy-documents

# Monitoring & Logging
LOG_FORMAT=json
ENABLE_METRICS=true
METRICS_PORT=9090

# Security
BCRYPT_COST=12
SECURE_COOKIES=true
TRUST_PROXY_HEADERS=false

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com