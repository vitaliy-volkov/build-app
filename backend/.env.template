# Production Environment Template for Строительная система управления
# Copy this file to .env.production and fill in your actual values

# =============================================================================
# CRITICAL SECURITY SETTINGS - MUST BE CHANGED FOR PRODUCTION
# =============================================================================

# JWT Secret - Generate a strong secret (32+ characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_TO_STRONG_SECRET_32_CHARS_MIN

# Database Password - Use strong password
DATABASE_PASSWORD=CHANGE_ME_TO_STRONG_DB_PASSWORD

# Redis Password - Use strong password  
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_REDIS_PASSWORD

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server port and timeouts
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=stroy_user
DATABASE_DBNAME=stroy_control
DATABASE_SSL_MODE=require

# Database connection pool settings
DATABASE_MAX_IDLE_CONNECTIONS=25
DATABASE_MAX_OPEN_CONNECTIONS=100
DATABASE_CONN_MAX_LIFETIME=5m

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Redis connection pool settings
REDIS_POOL_SIZE=25
REDIS_MIN_IDLE_CONNECTIONS=5
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# =============================================================================
# JWT CONFIGURATION
# =============================================================================

JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h
JWT_ISSUER=stroy-control-backend

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=info

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# IMPORTANT: Update these to your actual domains
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-Requested-With
CORS_EXPOSED_HEADERS=X-RateLimit-Limit,X-RateLimit-Remaining

# =============================================================================
# RATE LIMITING
# =============================================================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Role-based rate limits
RATE_LIMIT_ADMIN=1000
RATE_LIMIT_MANAGER=500
RATE_LIMIT_USER=100
RATE_LIMIT_ANONYMOUS=20

# =============================================================================
# FILE UPLOAD SETTINGS
# =============================================================================

MAX_FILE_SIZE=50MB
UPLOAD_PATH=/app/uploads
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,doc,docx,xls,xlsx

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# MinIO Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=stroy-documents

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

LOG_FORMAT=json
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30s

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

BCRYPT_COST=12
SECURE_COOKIES=true
TRUST_PROXY_HEADERS=false

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# SMTP Settings for notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=Строй-Контроль

# =============================================================================
# AI SERVICE CONFIGURATION
# =============================================================================

# Enable/disable AI features
AI_ENABLED=true
AI_GATEWAY_URL=http://ai-gateway:8000
AI_TIMEOUT=30s
AI_RETRY_ATTEMPTS=3

# AI Provider API Keys (from .secrets file)
# OPENAI_API_KEY=<set in .secrets>
# GEMINI_API_KEY=<set in .secrets>
# ANTHROPIC_API_KEY=<set in .secrets>

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================

NOTIFICATIONS_ENABLED=true
WEBSOCKET_ENABLED=true
WEBSOCKET_PATH=/ws
WEBSOCKET_BUFFER_SIZE=1000

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=stroy-backups

# =============================================================================
# ADVANCED PRODUCTION SETTINGS
# =============================================================================

# Performance tuning
GOGC=off
GIN_MODE=release

# Cache settings
CACHE_DEFAULT_TTL=1h
CACHE_SESSION_TTL=24h
CACHE_USER_PERMISSIONS_TTL=1h
CACHE_PROJECT_CACHE_TTL=30m
CACHE_ESTIMATE_CACHE_TTL=15m

# Security headers
SECURITY_X_CONTENT_TYPE_OPTIONS=nosniff
SECURITY_X_FRAME_OPTIONS=DENY
SECURITY_X_XSS_PROTECTION=1; mode=block
SECURITY_CSP=default-src 'self'

# =============================================================================
# DOMAIN-SPECIFIC SETTINGS
# =============================================================================

# Update these to your actual domains
BASE_URL=https://yourdomain.com
API_BASE_URL=https://api.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com

# =============================================================================
# NOTES FOR PRODUCTION DEPLOYMENT
# =============================================================================

# 1. Change all CHANGEME values to secure alternatives
# 2. Update CORS origins to your actual domains
# 3. Configure proper SMTP settings
# 4. Set up SSL/TLS certificates
# 5. Configure monitoring and alerting
# 6. Set up automated backups
# 7. Review all security settings