# Test/Development secrets for deployment testing
POSTGRES_PASSWORD=test_postgres_password_2024
REDIS_PASSWORD=test_redis_password_2024
JWT_SECRET=test_jwt_secret_key_for_production_security_2024_minimum_32_chars

# AI API Keys (placeholder values for testing)
OPENAI_API_KEY=sk-test_openai_api_key_here
ANTHROPIC_API_KEY=sk-ant-test_anthropic_api_key_here
GEMINI_API_KEY=test_google_gemini_api_key_here
GROQ_API_KEY=gsk_test_groq_api_key_here

# Email Configuration
SMTP_USERNAME=test@example.com
SMTP_PASSWORD=test_app_password_here

# Application URLs (for testing)
FRONTEND_URL=https://stroy-control.local
BACKEND_URL=https://stroy-control.local
AI_GATEWAY_URL=https://stroy-control.local

# SSL Certificates (using generated self-signed certs)
SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem

# External Services
S3_BUCKET_NAME=stroy-documents-test
S3_REGION=us-east-1
S3_ACCESS_KEY=test_access_key
S3_SECRET_KEY=test_secret_key

# Security
BCRYPT_COST=12
RATE_LIMIT_SECRET=test_rate_limiting_secret_2024

# Monitoring
GRAFANA_ADMIN_PASSWORD=test_grafana_password_2024
PROMETHEUS_RETENTION=200h

# Backup
AWS_ACCESS_KEY_ID=test_aws_access_key
AWS_SECRET_ACCESS_KEY=test_aws_secret_key
BACKUP_S3_BUCKET=stroy-backups-test