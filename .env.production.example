# Production Environment Configuration
# These variables should be set in your deployment platform (e.g., Vercel Project Settings)

# API URL (Backend)
# The full URL to your backend API
# Example: https://backend-production.railway.app/api/v1
VITE_API_URL=

# WebSocket URL
# The full URL to your backend WebSocket endpoint
# Example: wss://backend-production.railway.app/ws
VITE_WS_URL=

# Environment Name
VITE_APP_ENV=production

# Public URL
# The URL where the frontend is hosted
# Example: https://my-project.vercel.app
VITE_APP_PUBLIC_URL=

# AI Gateway URL
# The full URL to your AI Gateway service
# Example: https://ai-gateway.railway.app
VITE_AI_GATEWAY_URL=

# API Keys
# Google Gemini API Key
VITE_GEMINI_API_KEY=

# Instructions for Vercel:
# 1. Go to your Project Settings > Environment Variables
# 2. Add each of the above keys with their corresponding production values
# 3. Redeploy your application
