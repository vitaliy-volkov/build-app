# AI Gateway Configuration
APP_NAME="AI Gateway for Stroy-Control"
APP_VERSION="1.0.0"
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/stroy_control"

# Redis
REDIS_URL="redis://localhost:6380"
REDIS_CACHE_TTL=3600

# AI Providers API Keys (замените на реальные ключи)
OPENAI_API_KEY="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"
GOOGLE_API_KEY="your-google-api-key-here"
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# Vector Database
PINECONE_API_KEY="your-pinecone-api-key-here"
PINECONE_ENVIRONMENT="us-west1-gcp"
PINECONE_INDEX_NAME="construction-docs"

# Security
SECRET_KEY="your-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_PER_USER=100
RATE_LIMIT_WINDOW=3600

# AI Settings
MAX_TOKENS_PER_REQUEST=4000
DEFAULT_MODEL="gpt-4"
TEMPERATURE=0.7

# File Processing
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=["pdf", "jpg", "jpeg", "png"]

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
